# Build:            make
# Run:              ./parking_lot input.txt
# Tests:            make test
# Tests with ASan:  make test SANITIZE=1   (program: make SANITIZE=1 -> ./parking_lot_sanitize)
# Clean up:         make clean

CFLAGS   = -std=c11 -Wall -Wextra -Wpedantic -O2
CPPFLAGS = -Iinclude -MMD -MP
LDFLAGS  =

# Sanitizer builds get their own directory and binary name so they never mix with
# the normal build.
ifdef SANITIZE
CFLAGS  += -g -fsanitize=address,undefined -fno-omit-frame-pointer
LDFLAGS += -fsanitize=address,undefined
BUILD   := build-sanitize
TARGET  := parking_lot_sanitize
else
BUILD   := build
TARGET  := parking_lot
endif

# Everything except main.c is shared between the program and the tests.
LIB_SRCS := $(filter-out src/main.c,$(wildcard src/*.c))
LIB_OBJS := $(LIB_SRCS:src/%.c=$(BUILD)/%.o)
MAIN_OBJ := $(BUILD)/main.o

# Each tests/test_*.c is a standalone test program.
TEST_SRCS := $(wildcard tests/test_*.c)
TEST_BINS := $(TEST_SRCS:tests/%.c=$(BUILD)/tests/%)

# End-to-end cases: the program's output for tests/data/X.in must equal X.out.
E2E_INPUTS := $(wildcard tests/data/*.in)

.PHONY: all test clean

all: $(TARGET)

$(TARGET): $(MAIN_OBJ) $(LIB_OBJS)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)

$(BUILD)/%.o: src/%.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/tests/%: tests/%.c $(LIB_OBJS) | $(BUILD)/tests
	$(CC) $(CPPFLAGS) $(CFLAGS) $^ -o $@ $(LDFLAGS)

test: $(TEST_BINS) $(TARGET)
	@for t in $(TEST_BINS); do echo "== $$t"; ./$$t || exit 1; done
	@echo "== end-to-end: ./$(TARGET)"
	@for input in $(E2E_INPUTS); do \
		expected=$${input%.in}.out; \
		if ./$(TARGET) $$input | diff -u $$expected - > /dev/null; then \
			echo "ok    $$input"; \
		else \
			echo "FAIL  $$input (diff: expected vs actual)"; \
			./$(TARGET) $$input | diff -u $$expected -; \
			exit 1; \
		fi; \
	done
	@if ./$(TARGET) > /dev/null 2>&1; then echo "FAIL  no arguments should exit 1"; exit 1; \
		else echo "ok    no arguments -> usage, exit 1"; fi
	@if ./$(TARGET) tests/data/no_such_file.txt > /dev/null 2>&1; then \
		echo "FAIL  missing file should exit 1"; exit 1; \
		else echo "ok    missing input file -> exit 1"; fi

$(BUILD) $(BUILD)/tests:
	mkdir -p $@

clean:
	rm -rf build build-sanitize parking_lot parking_lot_sanitize

# Header dependencies generated by -MMD, so editing a .h rebuilds what uses it.
-include $(wildcard $(BUILD)/*.d $(BUILD)/tests/*.d)
